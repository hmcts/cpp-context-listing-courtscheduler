#!/bin/sh
# Pre-commit hook: scan staged changes for secrets using gitleaks.
# Installed automatically via the git-build-hook-maven-plugin on every mvn build.
#
# To install gitleaks:
#   macOS / Linux : brew install gitleaks
#   Windows       : choco install gitleaks

if ! command -v gitleaks > /dev/null 2>&1; then
    echo "-----------------------------------------------------------"
    echo "ERROR: gitleaks is not installed."
    echo "Install it before committing:"
    echo "  macOS/Linux : brew install gitleaks"
    echo "  Windows     : choco install gitleaks"
    echo "-----------------------------------------------------------"
    exit 1
fi

gitleaks protect --staged --config .gitleaks.toml
