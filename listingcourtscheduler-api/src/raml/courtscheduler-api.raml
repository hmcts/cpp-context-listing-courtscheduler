/judiciaries:
  get:
    description: |
      Judiciary queries, selected by response media type:
      search.available.judiciaries — typeahead search over reference-data judiciaries with optional
      in-courtscheduler availability filtering (was GET /judiciaries/search-available);
      judiciary.find.availability — judiciary availability over a date range (was GET /judiciaries/availability).
      Query parameters are the union of both variants and are therefore all optional at the contract
      level; each action validates its own required parameters.
      ...
      (mapping):
          responseType: application/vnd.courtscheduler.search.available.judiciaries+json
          name: courtscheduler.search.available.judiciaries
      (mapping):
          responseType: application/json
          name: courtscheduler.judiciary.find.availability
      ...
    queryParameters:
      search:
        description: Typeahead text (minimum 2 characters) — search.available.judiciaries
        type: string
        required: false
      judiciaryGroup:
        description: Optional judiciary group / type filter — search.available.judiciaries
        type: string
        required: false
      limit:
        description: Maximum judiciaries to return from reference data (default 50) — search.available.judiciaries
        type: string
        required: false
      dates:
        description: Comma-separated ISO dates (yyyy-MM-dd) when filtering by calendar dates without session types — search.available.judiciaries
        type: string
        required: false
      courtHouseId:
        description: Required with dates when availability is applied (same courthouse as sessions) — search.available.judiciaries
        type: string
        required: false
      courtScheduleIds:
        description: Comma-separated court schedule ids; implies session-type-aware availability and one courthouse — search.available.judiciaries
        type: string
        required: false
      ignoreAvailability:
        description: When true, skips internal availability filtering — search.available.judiciaries
        type: boolean
        required: false
        default: false
      startDate:
        description: Start date of the search range — judiciary.find.availability
        type: string
        required: false
      endDate:
        description: End date of the search range — judiciary.find.availability
        type: string
        required: false
      courtCentreId:
        description: Optional court centre ID to filter by — judiciary.find.availability
        type: string
        required: false
      pageSize:
        description: Optional page size for pagination. Default is 20 — judiciary.find.availability
        type: integer
        required: false
      pageNumber:
        description: Optional page number for pagination. Default is 1 — judiciary.find.availability
        type: integer
        required: false
      withJudiciary:
        description: Optional flag to include judiciaries in response. Default is true — judiciary.find.availability
        type: boolean
        required: false
    responses:
      200:
        body:
          application/vnd.courtscheduler.search.available.judiciaries+json:
            schema: !include json/schema/courtscheduler.search.available.judiciaries.json
            example: !include json/courtscheduler.search.available.judiciaries.json
          application/json:
            schema: !include json/schema/courtscheduler.find.judiciary.availability.json
            example: !include json/courtscheduler.find.judiciary.availability.json

