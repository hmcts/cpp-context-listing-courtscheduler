#%RAML 0.8
title: Court Scheduler API
baseUri: http://localhost:8080/listingcourtscheduler-api/rest/courtscheduler
mediaType: application/json
protocols: [ HTTP, HTTPS ]

/courtschedule:
  description: |
    Create Court Schedule
  post:
    description: |
      ...
      (mapping):
          requestType: application/vnd.courtscheduler.create+json
          name: courtscheduler.create
      ...
    body:
      application/vnd.courtscheduler.create+json:
        schema: !include json/schema/courtscheduler.create.json
        example: !include json/courtscheduler.create.json
    responses:
      202:
        description: OK

  get:
    description: |
      Query via parameters
      ...
      (mapping):
          responseType: application/vnd.courtscheduler.get+json
          name: courtscheduler.get.court_schedule
      ...
    queryParameters:
      courtCentreId:
        type: string
        required: true
      courtRoomId:
        type: string
        required: false
      businessType:
        type: string
        required: false
      sessionStartDate:
        type: string
        required: true
      sessionEndDate:
        type: string
        required: true
      isDraft:
        description: isDraft
        type: boolean
        required: false
      pageSize:
        description: Number of records to be displayed per page
        type: string
        required: true
      pageNumber:
        description: currentPageNumber details
        type: string
        required: true
    responses:
      200:
        body:
          application/vnd.courtscheduler.get+json:
            schema: !include json/schema/courtscheduler.get.court_schedule.json
            example: !include json/courtscheduler.get.court_schedule.json

/courtschedule/edit:
  post:
    description: |
      ...
      (mapping):
          requestType: application/vnd.courtscheduler.update+json
          name: courtscheduler.update
      ...
    body:
      application/vnd.courtscheduler.update+json:
        schema: !include json/schema/courtscheduler.update.json
        example: !include json/courtscheduler.update.json
    responses:
      202:
        description: OK

/courtschedule/assign.courtroom:
  post:
    description: |
      Assign a courtroom to multiple court sessions at once.
      ...
      (mapping):
          requestType: application/vnd.courtscheduler.assign.courtroom+json
          name: courtscheduler.assign.courtroom
      ...
    body:
      application/vnd.courtscheduler.assign.courtroom+json:
        schema: !include json/schema/courtscheduler.assign.courtroom.json
        example: !include json/courtscheduler.assign.courtroom.json
    responses:
      200:
        body:
          application/vnd.courtscheduler.assign.courtroom.response+json:
            schema: !include json/schema/courtscheduler.assign.courtroom.response.json
            example: !include json/courtscheduler.assign.courtroom.response.json

/courtschedule/delete:
  post:
    description: |
      ...
      (mapping):
          requestType: application/vnd.courtscheduler.delete+json
          name: courtscheduler.delete
      ...
    body:
      application/vnd.courtscheduler.delete+json:
        schema: !include json/schema/courtscheduler.delete.json
        example: !include json/courtscheduler.delete.json
    responses:
      200:
        body:
          application/vnd.courtscheduler.delete.response+json:
            schema: !include json/schema/courtscheduler.delete.response.json
            example: !include json/courtscheduler.delete.response.json

/sessions:
  description: |
    Court sessions (court schedules). Phase 1 introduces the backend slice: read-by-ids (05),
    judiciary assignment (06/07/08), and slot release (10). UI-facing create/edit/delete/assign-courtroom
    and slot search/book verbs arrive in Phase 2.
  get:
    description: |
      Returns a list of court schedules (sessions) for the provided session ids
      (was GET /courtschedule/search.court-schedules-by-id).
      ...
      (mapping):
          responseType: application/vnd.courtscheduler.search.court-schedules-by-id+json
          name: courtscheduler.search.court-schedules-by-id
      ...
    queryParameters:
      ids:
        description: Comma-separated list of session (court schedule) UUIDs
        type: string
        required: true
    responses:
      200:
        body:
          application/vnd.courtscheduler.search.court-schedules-by-id+json:
            schema: !include json/schema/courtscheduler.search.courtschedules.by.id.response.json
            example: !include json/courtscheduler.search.courtschedules.by.id.response.json

/sessions/judiciaries:
  post:
    description: |
      Assign or unassign a judiciary from court sessions (was POST /session). Batch request bodies
      preserved; the action is selected by media type.
      ...
      (mapping):
          requestType: application/vnd.courtscheduler.assign-judiciary+json
          name: courtscheduler.assign-judiciary
      (mapping):
          requestType: application/vnd.courtscheduler.unassign.judiciary+json
          name: courtscheduler.unassign.judiciary
      ...
    body:
      application/vnd.courtscheduler.assign-judiciary+json:
        schema: !include json/schema/courtscheduler.assign-judiciary.json
        example: !include json/courtscheduler.assign-judiciary.json
      application/vnd.courtscheduler.unassign.judiciary+json:
        schema: !include json/schema/courtscheduler.unassign.judiciary.json
        example: !include json/courtscheduler.unassign.judiciary.json
    responses:
      202:
        description: Request accepted for processing.
      400:
        description: Bad Request - Cannot unassign judiciary (has allocated listings or not found)
        body:
          application/json:
            example: |
              {
                "errorMessage": "Cannot unassign judiciary judge-456 from courtSchedule schedule-123: court schedule has allocated listings"
              }

/sessions/bulk-assign-judiciaries:
  post:
    description: |
      Replace-all assignment of judiciary to multiple court sessions (was
      POST /session/assign-judiciary-to-sessions). Clears existing judiciary rows for the given
      sessions, then persists the Cartesian product of judiciary and sessions. Validates same
      courthouse and bench composition.
      ...
      (mapping):
          requestType: application/vnd.courtscheduler.assign-judiciary-to-sessions+json
          name: courtscheduler.assign-judiciary-to-sessions
      ...
    body:
      application/vnd.courtscheduler.assign-judiciary-to-sessions+json:
        schema: !include json/schema/courtscheduler.assign-judiciary-to-sessions.json
        example: !include json/courtscheduler.assign-judiciary-to-sessions.json
    responses:
      202:
        description: Request accepted for processing.
      400:
        description: Bad request — mixed courthouses, invalid bench composition, or unknown sessions.

/sessions/remove-all-judiciaries:
  post:
    description: |
      Remove all judiciary from court sessions (was POST /session/remove-all-judiciary).
      ...
      (mapping):
          requestType: application/vnd.courtscheduler.remove-all-judiciary+json
          name: courtscheduler.remove-all-judiciary
      ...
    body:
      application/vnd.courtscheduler.remove-all-judiciary+json:
        schema: !include json/schema/courtscheduler.remove-all-judiciary.json
        example: !include json/courtscheduler.remove-all-judiciary.json
    responses:
      202:
        description: Request accepted for processing.
      400:
        description: Bad Request - Cannot remove all judiciary (invalid request or session not found)
        body:
          application/json:
            example: |
              {
                "errorMessage": "courtScheduleIds must contain at least one value"
              }

/sessions/{hearingId}:
  uriParameters:
    hearingId:
      description: The hearing whose booked sessions are to be released
      type: string
  delete:
    description: |
      Release the sessions booked for the given hearing (was DELETE /hearingslots/{hearingId}).
      ...
      (mapping):
          requestType: application/vnd.courtscheduler.release.sessions+json
          name: courtscheduler.release.sessions
      ...
    body:
      application/vnd.courtscheduler.release.sessions+json:
    responses:
      202:
        description: Request Accepted

/hearingslots:
  put:
    description:  |
      You can allocate a hearing slot through this POST request
      ...
      (mapping):
          requestType: application/vnd.courtscheduler.update.hearing.slots+json
          name: courtscheduler.update.hearing.slots
      ...
    body:
      application/vnd.courtscheduler.update.hearing.slots+json:
        example:
          !include json/courtscheduler.update.hearing.slots.json
        schema:
          !include json/schema/courtscheduler.update.hearing.slots.json
    responses:
      200:
        body:
          application/vnd.courtscheduler.update.hearing.slots.response+json:
            schema: !include json/schema/courtscheduler.update.hearing.slots.response.json
            example: !include json/courtscheduler.update.hearing.slots.response.json

  get:
    description: |
      Query via parameters
        ...
        (mapping):
            responseType: application/vnd.courtscheduler.get.hearing.slots+json
            name: courtscheduler.get.hearing.slots
        (mapping):
            responseType: application/vnd.courtscheduler.get.hearing.ids+json
            name: courtscheduler.get.hearing.ids
        ...
    queryParameters:
      panel:
        description: panel Type ( ADULT/YOUTH/ADULT,YOUTH)
        type: string
        required: true
      sessionStartDate:
        description: startDate
        type: string
        required: true
      sessionEndDate:
        description: endDate
        type: string
        required: true
      exactHearingStartDateTime:
        description: Optional parameter to perform an exact match on start_time. Must be in ISO date-time format in UTC i.e 2018-10-28T19:34:50.63Z. Used by court calendar only. secs/millisecs/nanos are stripped
        type: string
        required: false
      oucodeL2Code:
        description: Operational unit
        type: string
        required: false
      ouCode:
        description: Courthouse oucode
        type: string
        required: false
      courtRoomId:
        description: courtRoomId
        type: string
        required: false
      courtRoomNumber:
        description: courtRoomNumber
        type: string
        required: false
      businessType:
        description: businessType
        type: string
        required: false
      courtSession:
        description: AM/PM/AD or comma separeted --> AM,PM,AD
        type: string
        required: false
      isSlotBased:
        description: slot based or not
        type: string
        required: false
      hearingStartTime:
        description: hearingStartTime
        type: string
        required: false
      availableDurationMins:
        description: Available duration in minutes, used to filter court schedules and trigger multiday Crown search
        type: string
        required: false
      pageSize:
        description: Number of records to be displayed per page
        type: string
        required: true
      pageNumber:
        description: currentPageNumber details
        type: string
        required: true
      showOverbookedSlots:
        description: Value which holds whether to showOverbookedSlots
        type: boolean
        required: false
      status:
        description: Status filter for court schedules (DRAFT, FINAL, or ALL)
        type: string
        enum: [ DRAFT, FINAL, ALL ]
        required: false
        default: ALL
      jurisdiction:
        description: Court jurisdiction type
        type: string
        enum: [ CROWN, MAGISTRATES ]
        required: true
    responses:
      200:
        body:
          application/vnd.courtscheduler.get.hearing.slots+json:
            example: !include json/courtscheduler.get.hearing.slots.json
            schema: !include json/schema/courtscheduler.get.hearing.slots.json
          application/vnd.courtscheduler.get.hearing.ids+json:
            example: !include json/courtscheduler.get.hearing.ids.json
            schema: !include json/schema/courtscheduler.get.hearing.ids.json

/hearings:
  post:
    description:  |
      List a hearing into court session(s) already chosen for it — the batch "list into known sessions"
      path (was PUT /list/hearingslots).
      ...
      (mapping):
          requestType: application/vnd.courtscheduler.list.hearings-in-sessions+json
          name: courtscheduler.list.hearings-in-sessions
      ...
    body:
      application/vnd.courtscheduler.list.hearings-in-sessions+json:
        example:
          !include json/courtscheduler.list.hearings-in-sessions.json
        schema:
          !include json/schema/courtscheduler.list.hearings-in-sessions.json
    responses:
      200:
        description: OK
        body:
          application/vnd.courtscheduler.list.hearings-in-sessions.response+json:
            schema: !include json/schema/courtscheduler.list.hearings-in-sessions.response.json
            example: !include json/courtscheduler.list.hearings-in-sessions.response.json

/hearings/{hearingId}:
  uriParameters:
    hearingId:
      description: The hearing the booking action applies to
      type: string
  post:
    description:  |
      Search-and-book for a hearing, selected by media-type action:
      crown.search.and.book (CROWN; single or multi-day; optional courtScheduleId anchor; relaxed fallback on the single-day path);
      mags.search.and.book (MAGISTRATES SPI; single or multi-day CONSECUTIVE; isPolice overbooking; never anchors);
      move-hearing-to-past-date (both jurisdictions via a jurisdiction field; past-only);
      change-court-room-for-multiday-hearing (re-allocates ONLY the submitted day(s) of an existing
      multi-day hearing onto new sessions; days not submitted are untouched).
      The hearing is identified by the hearingId path parameter; it is not part of any request body.
      ...
      (mapping):
          requestType: application/vnd.courtscheduler.crown.search.and.book+json
          name: courtscheduler.crown.search.and.book
      (mapping):
          requestType: application/vnd.courtscheduler.mags.search.and.book+json
          name: courtscheduler.mags.search.and.book
      (mapping):
          requestType: application/vnd.courtscheduler.move-hearing-to-past-date+json
          name: courtscheduler.move-hearing-to-past-date
      (mapping):
          requestType: application/vnd.courtscheduler.change-court-room-for-multiday-hearing+json
          name: courtscheduler.change-court-room-for-multiday-hearing
      ...
    body:
      application/vnd.courtscheduler.crown.search.and.book+json:
        schema: !include json/schema/courtscheduler.crown.search.and.book.json
        example: !include json/courtscheduler.crown.search.and.book.json
      application/vnd.courtscheduler.mags.search.and.book+json:
        schema: !include json/schema/courtscheduler.mags.search.and.book.json
        example: !include json/courtscheduler.mags.search.and.book.json
      application/vnd.courtscheduler.move-hearing-to-past-date+json:
        schema: !include json/schema/courtscheduler.move-hearing-to-past-date.json
        example: !include json/courtscheduler.move-hearing-to-past-date.json
      application/vnd.courtscheduler.change-court-room-for-multiday-hearing+json:
        schema: !include json/schema/courtscheduler.change-court-room-for-multiday-hearing.json
        example: !include json/courtscheduler.change-court-room-for-multiday-hearing.json
    responses:
      200:
        body:
          application/vnd.courtscheduler.crown.search.and.book.response+json:
            schema: !include json/schema/courtscheduler.crown.search.and.book.response.json
            example: !include json/courtscheduler.crown.search.and.book.response.json
          application/vnd.courtscheduler.mags.search.and.book.response+json:
            schema: !include json/schema/courtscheduler.mags.search.and.book.response.json
            example: !include json/courtscheduler.mags.search.and.book.response.json
          application/vnd.courtscheduler.move-hearing-to-past-date.response+json:
            schema: !include json/schema/courtscheduler.move-hearing-to-past-date.response.json
            example: !include json/courtscheduler.move-hearing-to-past-date.response.json
          application/vnd.courtscheduler.change-court-room-for-multiday-hearing.response+json:
            schema: !include json/schema/courtscheduler.change-court-room-for-multiday-hearing.response.json
            example: !include json/courtscheduler.change-court-room-for-multiday-hearing.response.json
      422:
        description: |
          Booking failed with errorCode NO_SESSION_FOUND when no session (or qualifying consecutive
          run) is available for the request, or NO_ALLOCATION_ON_DATE when
          change-court-room-for-multiday-hearing is requested for a date the hearing isn't
          currently allocated on.
  patch:
    description:  |
      Extend, shrink, or no-op a CROWN multi-day hearing booking (was POST /extendmultidayhearing/hearingslots).
      ...
      (mapping):
          requestType: application/vnd.courtscheduler.extend.multiday.hearing+json
          name: courtscheduler.extend.multiday.hearing
      ...
    body:
      application/vnd.courtscheduler.extend.multiday.hearing+json:
        schema: !include json/schema/courtscheduler.extend.multiday.hearing.json
        example: !include json/courtscheduler.extend.multiday.hearing.json
    responses:
      200:
        body:
          application/vnd.courtscheduler.extend.multiday.hearing.response+json:
            schema: !include json/schema/courtscheduler.extend.multiday.hearing.response.json
            example: !include json/courtscheduler.extend.multiday.hearing.response.json
      422:
        description: |
          Booking cannot be extended. errorCode: NO_EXISTING_ALLOCATION, START_DATE_CHANGE_NOT_ALLOWED, NO_AVAILABILITY, INVALID_DATE_RANGE.
        body:
          application/vnd.courtscheduler.extend.multiday.hearing.error+json:
            schema: !include json/schema/courtscheduler.extend.multiday.hearing.error.json
            example: !include json/courtscheduler.extend.multiday.hearing.error.json

/provisionalBooking:
  post:
    description:  |
      You can book slot provisionally by giving corresponding courtScheduleId(s) inside request body
      ...
        (mapping):
            requestType: application/vnd.courtscheduler.create.provisional.booking+json
            name: courtscheduler.create.provisional.booking
      ...
    body:
      application/vnd.courtscheduler.create.provisional.booking+json:
        schema:  !include json/schema/courtscheduler.create.provisional.booking.json
        example:  !include json/courtscheduler.create.provisional.booking.json
    responses:
      200:
        body:
          example: !include json/courtscheduler.create.provisional.booking.response.json
          schema:  !include json/schema/courtscheduler.create.provisional.booking.response.json

  get:
    description:  |
      Query via parameters
      ...
        (mapping):
            responseType: application/vnd.courtscheduler.get.provisional.booking+json
            name: courtscheduler.get.provisional.booking
      ...
    queryParameters:
      bookingIds:
        description: booking ids as comma separated
        type: string
        required: true
    responses:
      200:
        body:
          application/vnd.courtscheduler.get.provisional.booking+json:
            example: !include json/courtscheduler.get.provisional.booking.json
            schema:  !include json/schema/courtscheduler.get.provisional.booking.json

/mi/court_schedules:
  get:
    description: |
      Query via parameters
        ...
        (mapping):
            responseType: application/vnd.courtscheduler.export.court_schedule+json
            name: courtscheduler.export.court_schedule
        ...
    queryParameters:
      fromDate:
        description: from date of the data range
        type: string
        required: true
      toDate:
        description: to date of the data range
        type: string
        required: true
    responses:
      200:
        body:
          application/vnd.courtscheduler.export.court_schedule+json:
            example: !include json/courtscheduler.export.court_schedule.json
            schema: !include json/schema/courtscheduler.export.court_schedule.json

/mi/court_schedule_judiciaries:
  get:
    description: |
      Query via parameters
        ...
        (mapping):
            responseType: application/vnd.courtscheduler.export.court_schedule_judiciary+json
            name: courtscheduler.export.court_schedule_judiciary
        ...
    queryParameters:
      fromDate:
        description: from date of the data range
        type: string
        required: true
      toDate:
        description: to date of the data range
        type: string
        required: true
    responses:
      200:
        body:
          application/vnd.courtscheduler.export.court_schedule_judiciary+json:
            example: !include json/courtscheduler.export.court_schedule_judiciary.json
            schema: !include json/schema/courtscheduler.export.court_schedule_judiciary.json

/mi/allocated_listings:
  get:
    description: |
      Query via parameters
        ...
        (mapping):
            responseType: application/vnd.courtscheduler.export.allocated_listings+json
            name: courtscheduler.export.allocated_listings
        ...
    queryParameters:
      fromDate:
        description: from date of the data range
        type: string
        required: true
      toDate:
        description: to date of the data range
        type: string
        required: true
    responses:
      200:
        body:
          application/vnd.courtscheduler.export.allocated_listings+json:
            example: !include json/courtscheduler.export.allocated_listings.json
            schema: !include json/schema/courtscheduler.export.allocated_listings.json

/rotasl/process-rota-files:
  post:
    description: |
      unprocessed rotasl files should be pulled from azure container and being processed into scsl database for the schedule of the ljas
        ...
        (mapping):
            requestType: application/vnd.courtscheduler.rotasl.process_rota_files+json
            name: courtscheduler.rotasl.process_rota_files
        ...
    body:
      application/vnd.courtscheduler.rotasl.process_rota_files+json:
        schema: !include json/schema/courtscheduler.rotasl.process_rota_files.json
        example: !include json/courtscheduler.rotasl.process_rota_files.json
    responses:
      202:
        description: Request Accepted

/rotasl/clean-redundant-rota-data:
  post:
    description: |
      deleting rotasl processed redundant data older than N months
        ...
        (mapping):
            requestType: application/vnd.courtscheduler.rotasl.clean_redundant_rota_data+json
            name: courtscheduler.rotasl.clean_redundant_rota_data
        ...
    body:
      application/vnd.courtscheduler.rotasl.clean_redundant_rota_data+json:
        schema: !include json/schema/courtscheduler.rotasl.clean_redundant_rota_data.json
        example: !include json/courtscheduler.rotasl.clean_redundant_rota_data.json
    responses:
      202:
        description: Request Accepted

/validate:
  description: |
    validate your request before you call the actual endpoint
  post:
    description: |
      ...
      (mapping):
          requestType: application/vnd.courtscheduler.validate.create+json
          name: courtscheduler.validate.create
      (mapping):
          requestType: application/vnd.courtscheduler.validate.update+json
          name: courtscheduler.validate.update
      (mapping):
          requestType: application/vnd.courtscheduler.validate.delete+json
          name: courtscheduler.validate.delete
      ...
    body:
      application/vnd.courtscheduler.validate.create+json:
        schema: !include json/schema/courtscheduler.validate.create.json
        example: !include json/courtscheduler.validate.create.json
      application/vnd.courtscheduler.validate.update+json:
        schema: !include json/schema/courtscheduler.validate.update.json
        example: !include json/courtscheduler.validate.update.json
      application/vnd.courtscheduler.validate.delete+json:
        schema: !include json/schema/courtscheduler.validate.delete.json
        example: !include json/courtscheduler.validate.delete.json

    responses:
      200:
        description: OK
      400:
        body:
          application/vnd.courtscheduler.validate.create.response+json:
            schema: !include json/schema/courtscheduler.validate.response.json
            example: !include json/courtscheduler.validate.response.json
          application/vnd.courtscheduler.validate.update.response+json:
            schema: !include json/schema/courtscheduler.validate.response.json
            example: !include json/courtscheduler.validate.response.json
          application/vnd.courtscheduler.validate.delete.response+json:
            schema: !include json/schema/courtscheduler.validate.response.json
            example: !include json/courtscheduler.validate.response.json

/validate-session-availability:
  description: |
    validate session availability before you call the actual endpoint
  post:
    description: |
      ...
      (mapping):
          requestType: application/vnd.courtscheduler.validate.session.availability+json
          name: courtscheduler.validate.session.availability
      ...
    body:
      application/vnd.courtscheduler.validate.session.availability+json:
        schema: !include json/schema/courtscheduler.validate.session.availability.json
        example: !include json/courtscheduler.validate.session.availability.json

    responses:
      200:
        description: OK
      400:
        body:
          application/vnd.courtscheduler.validate.session.availability.response+json:
            schema: !include json/schema/courtscheduler.validate.session.availability.response.json
            example: !include json/courtscheduler.validate.session.availability.response.json

/judiciaries/availability-rules:
  get:
    description: |
      Find judiciary availability rules.
      ...
      (mapping):
        responseType: application/json
        name: courtscheduler.judiciary.find.availability.rule
      ...
    queryParameters:
      startDate:
        description: Start date of the search range (Not in past)
        type: string
        required: true
      endDate:
        description: End date of the search range (Not in past)
        type: string
        required: true
      courtCentreId:
        description: Optional court centre ID to filter by
        type: string
        required: false
      pageSize:
        description: Optional page size for pagination. Default is 20
        type: integer
        required: false
      pageNumber:
        description: Optional page number for pagination. Default is 1
        type: integer
        required: false
      withJudiciary:
        description: Optional flag to include judiciaries in response. Default is true
        type: boolean
        required: false

    responses:
      200:
        body:
          application/json:
            schema: !include json/schema/courtscheduler.find.judiciary.availability.rule.json
            example: !include json/courtscheduler.find.judiciary.availability.rule.json

/judiciaries/availability-rules/{ruleId}:
  get:
    description: |
      Get a single judiciary availability rule by ruleId
      ...
      (mapping):
