{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "courtSchedules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "courtScheduleId": { "type": "string", "format": "uuid" },
          "sessionDate": { "type": "string", "format": "date" },
          "hearingStartTime": { "type": "string" },
          "hearingEndTime": { "type": "string" },
          "isDraft": { "type": "boolean" },
          "businessType": { "type": "string" },
          "courtSession": {
            "type": "string",
            "enum": ["AD"]
          },
          "courtRoomId": { "type": "string", "format": "uuid" },
          "courtRoomName": { "type": "string" },
          "courtHouseId": { "type": "string", "format": "uuid" },
          "oucode": { "type": "string" }
        },
        "required": [
          "courtScheduleId",
          "sessionDate",
          "hearingStartTime",
          "hearingEndTime",
          "isDraft",
          "businessType",
          "courtSession",
          "courtRoomId",
          "courtRoomName",
          "courtHouseId",
          "oucode"
        ]
      }
    }
  },
  "required": ["courtSchedules"]
}
