{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "hearingId": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "courtScheduleId": {
            "type": "string"
          },
          "sessionDate": {
            "type": "string",
            "format": "date"
          },
          "courtRoomId": {
            "type": "string"
          },
          "businessType": {
            "type": "string"
          },
          "isDraft": {
            "type": "boolean"
          },
          "hearingId": {
            "type": "string"
          },
          "sessionStartTime": {
            "type": "string"
          },
          "sessionEndTime": {
            "type": "string"
          },
          "durationInMinutes": {
            "type": "integer"
          },
          "source": {
            "type": "string"
          },
          "overbooked": {
            "type": "boolean"
          }
        }
      },
      "description": "MAGISTRATES: one item per booked day with main's fields - sessionStartTime/sessionEndTime are the SUBMITTED start/end on that day and durationInMinutes the submitted window. CROWN: the booked court-schedule sessions."
    }
  },
  "required": [
    "hearingId",
    "sessions"
  ]
}
