{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "hearingSlots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "hearingId": {
            "type": "string"
          },
          "courtScheduleIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "courtScheduleId": {
                  "type": "string"
                },
                "sessionStartTime": {
                  "type": "string",
                  "format": "date-time"
                },
                "durationInMinutes": {
                  "type": "integer"
                }
              },
              "required": [
                "courtScheduleId"
              ]
            }
          }
        },
        "required": [
          "hearingId",
          "courtScheduleIds"
        ]
      }
    }
  },
  "required": [
    "hearingSlots"
  ]
}
