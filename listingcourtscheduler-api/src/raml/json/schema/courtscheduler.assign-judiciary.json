{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "judiciaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "judiciaryId": {
            "type": "string",
            "minLength": 1
          },
          "sessionIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            }
          },
          "isDeputy": {
            "type": "boolean"
          },
          "isBenchChairman": {
            "type": "boolean"
          },
          "position": {
            "type": "string"
          }
        },
        "required": [
          "judiciaryId",
          "sessionIds"
        ],
        "additionalProperties": false
      }
    },
    "skipValidations": {
      "type": "boolean",
      "description": "If true, skip all validations for this request. Defaults to false."
    }
  },
  "required": [
    "judiciaries"
  ],
  "additionalProperties": false
}

