{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "hearingId": {
      "type": "string"
    },
    "courtScheduleId": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "courtScheduleId": {
            "type": "string"
          },
          "sessionDate": {
            "type": "string",
            "format": "date"
          },
          "courtRoomId": {
            "type": "string"
          },
          "businessType": {
            "type": "string"
          },
          "isDraft": {
            "type": "boolean"
          }
        }
      }
    },
    "courtRoomId": {
      "type": "string",
      "description": "court_schedule.court_room_id UUID of the booked session (single-day only; null for draft sessions)"
    },
    "sessionDate": {
      "type": "string",
      "format": "date"
    },
    "sessionStartTime": {
      "type": "string"
    },
    "sessionEndTime": {
      "type": "string"
    },
    "durationInMinutes": {
      "type": "integer"
    },
    "isDraft": {
      "type": "boolean"
    },
    "businessType": {
      "type": "string"
    },
    "overbooked": {
      "type": "boolean"
    }
  },
  "required": [
    "hearingId",
    "sessions"
  ]
}
