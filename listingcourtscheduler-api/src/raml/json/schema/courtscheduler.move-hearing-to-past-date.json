{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "courtCentreId": {
      "type": "string",
      "format": "uuid"
    },
    "courtRoomId": {
      "type": "string",
      "format": "uuid"
    },
    "jurisdiction": {
      "type": "string",
      "enum": [
        "CROWN",
        "MAGISTRATES"
      ]
    },
    "startTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "endTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "durationInMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 360
    }
  },
  "required": [
    "courtCentreId",
    "courtRoomId",
    "jurisdiction",
    "startTime"
  ],
  "additionalProperties": false
}
