      "items": {
        "type": "object",
        "properties": {
          "hearingId": {
            "type": "string"
          },
          "courtScheduleId": {
            "type": "string"
          },
          "bookingId": {
            "type": "string"
          },
          "hearingStartTime": {
            "type": "string"
          },
          "isSlotBased": {
            "type": "boolean"
          },
          "ouCode": {
            "type": "string"
          },
          "courtRoomId": {
            "type": "string"
          },
          "session": {
            "type": "string"
          },
          "sessionDate": {
            "type": "string"
          },
          "duration": {
            "type": "integer"
          }
        },
        "required": [
          "courtScheduleId",
          "hearingId",
          "ouCode",
          "courtRoomId",
          "session",
          "sessionDate",
          "duration"
        ]
