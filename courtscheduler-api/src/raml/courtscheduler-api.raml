#%RAML 0.8
title: Court Scheduler API
baseUri: http://localhost:8080/courtscheduler-api/rest/courtscheduler
mediaType: application/json
protocols: [ HTTP, HTTPS ]

/courtschedule:
  description: |
    Create Court Schedule
  post:
    description: |
      ...
      (mapping):
          requestType: application/vnd.courtscheduler.create+json
          name: courtscheduler.create
      ...

    body:
      application/vnd.courtscheduler.create+json:
        schema: !include json/schema/courtscheduler.create.json
        example: !include json/courtscheduler.create.json

    responses:
      202:
        description: OK
  get:
    description: |
      Query via parameters
      ...
      (mapping):
          responseType: application/vnd.courtscheduler.get+json
          name: courtscheduler.get
      ...
    queryParameters:
      courtCentreId:
        type: string
        required: true
      courtRoomId:
        type: string
        required: false
      businessType:
        type: string
        required: false
      startDate:
        type: string
        required: true
      numberOfWeeks:
        type: string
        required: true
      endDate:
        type: string
        required: false
    responses:
      200:
        body:
          application/vnd.courtscheduler.get+json:
            schema: !include json/schema/courtscheduler.get.json
            example: !include json/courtscheduler.get.json

/hearingslots:
  post:
    description:  |
      You can allocate a hearing slot through this POST request
      ...
      (mapping):
          requestType: application/vnd.courtscheduler.update.hearing.slots+json
          name: courtscheduler.update.hearing.slots
      ...
    body:
      application/vnd.courtscheduler.update.hearing.slots+json:
        example:
          !include json/courtscheduler.update.hearing.slots.json
        schema:
          !include json/schema/courtscheduler.update.hearing.slots.json
    responses:
      204:
        description: No Content
  get:
    description: |
      Query via parameters
        ...
        (mapping):
            responseType: application/vnd.courtscheduler.get.hearing.slots+json
            name: courtscheduler.get.hearing.slots
        ...
    queryParameters:
      panel:
        description: panel Type ( ADULT/YOUTH/ADULT,YOUTH)
        type: string
        required: true
      sessionStartDate:
        description: startDate
        type: string
        required: true
      sessionEndDate:
        description: endDate
        type: string
        required: true
      oucodeL2Code:
        description: Operational unit
        type: string
        required: false
      ouCode:
        description: Courthouse oucode
        type: string
        required: false
      courtRoomId:
        description: courtRoomId
        type: string
        required: false
      courtRoomNumber:
        description: courtRoomNumber
        type: string
        required: false
      businessType:
        description: businessType
        type: string
        required: false
      courtSession:
        description: AM/PM/AD or comma separeted --> AM,PM,AD
        type: string
        required: false
      pageSize:
        description: Number of records to be displayed per page
        type: string
        required: true
      pageNumber:
        description: currentPageNumber details
        type: string
        required: true
    responses:
      200:
        body:
          application/vnd.courtscheduler.get.hearing.slots+json:
            example: !include json/courtscheduler.get.hearing.slots.json
            schema: !include json/schema/courtscheduler.get.hearing.slots.json