<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.3.xsd">

    <changeSet id="049" author="system" logicalFilePath="049-create-judiciary-availability-rule.xml">
        <createTable tableName="judiciary_availability_rule">
            <column name="id" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="judiciary_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="court_house_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="from_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="to_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="session_type" type="VARCHAR(10)" defaultValue="AD">
                <constraints nullable="false"/>
            </column>
            <column name="created_on" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_on" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="judiciary_availability_rule_repeat_day">
            <column name="rule_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="day_of_week" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="judiciary_availability_rule_repeat_day"
                       columnNames="rule_id,day_of_week"
                       constraintName="pk_judiciary_availability_rule_repeat_days"/>
        <addForeignKeyConstraint baseTableName="judiciary_availability_rule_repeat_day"
                                 baseColumnNames="rule_id"
                                 constraintName="fk_judiciary_availability_rule_repeat_day"
                                 referencedTableName="judiciary_availability_rule"
                                 referencedColumnNames="id" onDelete="CASCADE"/>

        <createIndex indexName="idx_judiciary_availability_rule_judiciary_id"
                     tableName="judiciary_availability_rule">
            <column name="judiciary_id"/>
        </createIndex>
        <createIndex indexName="idx_judiciary_availability_rule_court_house_id"
                     tableName="judiciary_availability_rule">
            <column name="court_house_id"/>
        </createIndex>
        <createIndex indexName="idx_judiciary_availability_rule_dates"
                     tableName="judiciary_availability_rule">
            <column name="from_date"/>
            <column name="to_date"/>
        </createIndex>
    </changeSet>

    <changeSet id="049-2" author="system"
               logicalFilePath="049-create-judiciary-availability-rule.xml">
        <createTable tableName="judiciary_unavailability">
            <column name="id" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="availability_rule_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="from_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="to_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(500)"/>
            <column name="created_on" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_on" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="judiciary_unavailability"
                                 baseColumnNames="availability_rule_id"
                                 constraintName="fk_judiciary_unavailability_availability_rule_id"
                                 referencedTableName="judiciary_availability_rule"
                                 referencedColumnNames="id" onDelete="CASCADE"/>

        <createIndex indexName="idx_judiciary_unavailability_availability_rule_id"
                     tableName="judiciary_unavailability">
            <column name="availability_rule_id"/>
        </createIndex>
        <createIndex indexName="idx_judiciary_unavailability_dates"
                     tableName="judiciary_unavailability">
            <column name="from_date"/>
            <column name="to_date"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
