<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.3.xsd">

    <changeSet id="038" author="koray.kaya" logicalFilePath="038-add-ad-split-max-morning-afternoon-column-court-schedule.xml">
        <addColumn tableName="court_schedule">
            <column name="support_ad_split" type="BOOLEAN" defaultValue="false"/>
        </addColumn>
        <addColumn tableName="court_schedule">
            <column name="max_ad_morning_duration" type="NUMERIC"  defaultValue="0"/>
        </addColumn>
        <addColumn tableName="court_schedule">
            <column name="max_ad_afternoon_duration" type="NUMERIC" defaultValue="0"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
