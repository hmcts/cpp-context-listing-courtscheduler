<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.3.xsd">

    <changeSet id="022" author="samialpak" logicalFilePath="022-rota-file-process-history.xml">
        <createTable tableName="rota_file_process_history">
            <column name="file_name_prefix" type="VARCHAR(100)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_rota_file_process_history"/>
            </column>
            <column name="file_date" type="DATETIME">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_rota_file_process_history"/>
            </column>
            <column name="processed_on" type="DATETIME"/>
        </createTable>
    </changeSet>
</databaseChangeLog>