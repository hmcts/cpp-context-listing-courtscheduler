<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.3.xsd">

    <changeSet id="019" author="samialpak" logicalFilePath="019-add-slotbased-to-court-schedule.xml">
        <addColumn tableName="court_schedule">
            <column name="is_slot_based" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="court_schedule" columnName="slot" />
        </rollback>
    </changeSet>

</databaseChangeLog>
