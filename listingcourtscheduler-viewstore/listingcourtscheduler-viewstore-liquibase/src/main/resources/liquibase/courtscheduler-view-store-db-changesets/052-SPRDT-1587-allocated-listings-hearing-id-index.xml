<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.3.xsd">

    <changeSet id="052-allocated-listings-hearing-id-index" author="koray.kaya" runInTransaction="false"
               logicalFilePath="052-SPRDT-1587-allocated-listings-hearing-id-index.xml">
        <sql>
            CREATE UNIQUE INDEX CONCURRENTLY IF NOT EXISTS allocated_listings_hearing_id_court_schedule_id_idx
            ON allocated_listings (hearing_id, court_schedule_id);
        </sql>
    </changeSet>

    <changeSet id="052-drop-court-schedule-hearing-id-idx" author="koray.kaya" runInTransaction="false"
               logicalFilePath="052-SPRDT-1587-allocated-listings-hearing-id-index.xml">
        <preConditions onFail="MARK_RAN">
            <indexExists indexName="allocated_listings_hearing_id_court_schedule_id_idx" tableName="allocated_listings"/>
        </preConditions>
        <sql>
            DROP INDEX CONCURRENTLY IF EXISTS court_schedule_hearing_id_idx;
        </sql>
    </changeSet>
</databaseChangeLog>
