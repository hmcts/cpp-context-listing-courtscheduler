                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.3.xsd">

    <changeSet id="029" author="ragubalan.durairaj"
               logicalFilePath="029-add-primary-key-to-courtscheduler-migration-status.xml">
        <preConditions onFail="MARK_RAN">
            <not>
                <primaryKeyExists tableName="courtscheduler_migration_status" primaryKeyName="courtscheduler_migration_status_pkey"/>
