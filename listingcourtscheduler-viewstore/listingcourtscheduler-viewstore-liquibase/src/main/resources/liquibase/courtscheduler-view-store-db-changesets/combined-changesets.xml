    <!-- 041-update_session_start_end_times_remove_bst.xml -->
    <changeSet id="041" author="baris.ozturkmen" logicalFilePath="041-update_session_start_end_times_remove_bst.xml">
        <sql>
            UPDATE court_schedule
            SET
            session_start_time = session_start_time - INTERVAL '1 hour',
            session_end_time = session_end_time - INTERVAL '1 hour'
            WHERE
            session_start_time AT TIME ZONE 'Europe/London' != session_start_time AT TIME ZONE 'UTC';
        </sql>
    </changeSet>

    <!-- 042-add_national_break_time_column.xml -->
    <changeSet id="042" author="baris.ozturkmen" logicalFilePath="042-add_national_break_time_column.xml">
        <addColumn tableName="court_schedule">
            <column name="national_break_time" type="timestamp with time zone">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <sql>
            UPDATE court_schedule
            SET national_break_time = 
                CASE 
                    WHEN session_start_time AT TIME ZONE 'Europe/London' != session_start_time AT TIME ZONE 'UTC'
                    THEN (DATE_TRUNC('day', session_start_time) + INTERVAL '12:00:00')::timestamp with time zone
                    ELSE (DATE_TRUNC('day', session_start_time) + INTERVAL '13:00:00')::timestamp with time zone
                END;
        </sql>

        <addNotNullConstraint tableName="court_schedule" columnName="national_break_time"/>
    </changeSet>

