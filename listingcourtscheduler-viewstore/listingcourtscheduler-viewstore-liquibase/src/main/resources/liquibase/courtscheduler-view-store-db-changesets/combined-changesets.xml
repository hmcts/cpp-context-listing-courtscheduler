<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.3.xsd">

    <!-- 001-court-room-mapping.xml -->
    <changeSet id="001" author="sshetty" logicalFilePath="001-court-room-mapping.xml">
        <createTable tableName="court_room_mapping">
            <column name="id" type="VARCHAR(100)"/>
            <column name="location_id" type="NUMERIC">
                <constraints nullable="false"/>
            </column>
            <column name="venue_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="oucode" type="VARCHAR(10)"/>
            <column name="court_house_name" type="VARCHAR(255)"/>
            <column name="court_room_name" type="VARCHAR(255)"/>
            <column name="operational_unit" type="VARCHAR(255)"/>
            <column name="active" type="BOOLEAN" defaultValue="true"/>
            <column name="court_room_id" type="NUMERIC"/>
            <column name="created_on" type="DATETIME"/>
        </createTable>

        <createIndex indexName="idx_court_room_mapping"
                     tableName="court_room_mapping">
            <column name="location_id"/>
            <column name="venue_name"/>
        </createIndex>
    </changeSet>

    <!-- 002-court-room-session-allocation.xml -->
    <changeSet id="002" author="sshetty" logicalFilePath="002-court-room-session-allocation.xml">
        <createTable tableName="court_room_session_allocation">
            <column name="court_room_session_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="oucode" type="VARCHAR(10)"/>
            <column name="court_room_id" type="NUMERIC"/>
            <column name="court_session" type="VARCHAR(10)"/>
            <column name="rota_business_type" type="VARCHAR(10)"/>
            <column name="max_slot" type="NUMERIC"/>
            <column name="max_duration_mins" type="NUMERIC"/>
            <column name="active" type="BOOLEAN" defaultValue="true"/>
            <column name="created_on" type="DATETIME"/>
        </createTable>

        <createIndex indexName="idx_court_room_session_allocation"
                     tableName="court_room_session_allocation">
            <column name="oucode"/>
            <column name="court_room_id"/>
            <column name="court_session"/>
            <column name="rota_business_type"/>
        </createIndex>
    </changeSet>

    <!-- 003-allocated_listings.xml -->
    <changeSet id="003" author="sshetty" logicalFilePath="003-allocated-listings.xml">
        <createTable tableName="allocated_listings">
            <column name="id" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="court_schedule_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="booking_id" type="VARCHAR(100)"/>
            <column name="hearing_id" type="VARCHAR(100)"/>
            <column name="oucode" type="VARCHAR(10)"/>
            <column name="court_room_id" type="NUMERIC"/>
            <column name="rota_business_type" type="VARCHAR(10)"/>
            <column name="duration" type="NUMERIC"/>
            <column name="created_on" type="DATETIME"/>
            <column name="updated_on" type="DATETIME"/>
        </createTable>
    </changeSet>

    <!-- 004-court-schedule.xml -->
    <changeSet id="004" author="sshetty" logicalFilePath="004-court-schedule.xml">
        <createTable tableName="court_schedule">
            <column name="id" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="court_listing_profile_id" type="VARCHAR(100)"/>
            <column name="oucode" type="VARCHAR(10)"/>
            <column name="court_room_id" type="NUMERIC"/>
            <column name="court_house_name" type="VARCHAR(255)"/>
            <column name="court_room_name" type="VARCHAR(255)"/>
            <column name="operational_unit" type="VARCHAR(255)"/>
            <column name="rota_business_type" type="VARCHAR(10)"/>
            <column name="court_session" type="VARCHAR(10)"/>
            <column name="session_start" type="DATE"/>
            <column name="panel" type="VARCHAR(10)"/>
            <column name="max_slot" type="NUMERIC"/>
            <column name="max_duration_mins" type="NUMERIC"/>
            <column name="available_slot" type="NUMERIC"/>
            <column name="available_duration_mins" type="NUMERIC"/>
            <column name="active" type="BOOLEAN" defaultValue="true"/>
            <column name="created_on" type="DATETIME"/>
            <column name="updated_on" type="DATETIME"/>
        </createTable>
    </changeSet>

