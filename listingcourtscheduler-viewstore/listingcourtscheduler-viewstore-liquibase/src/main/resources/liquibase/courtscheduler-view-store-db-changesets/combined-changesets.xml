    <changeSet id="040" author="koray.kaya" logicalFilePath="039-add-session_start_time-session_end_time-columns-court-schedule.xml">
        <update tableName="court_schedule">
            <column name="session_start_time" valueComputed="CASE
        WHEN court_session = 'AM' THEN (session_start || ' 10:00:00')::timestamp
        WHEN court_session = 'PM' THEN (session_start || ' 14:00:00')::timestamp
        WHEN court_session = 'AD' THEN (session_start || ' 00:01:00')::timestamp
        ELSE NULL
    END"/>
            <column name="session_end_time" valueComputed="CASE
        WHEN court_session = 'AM' THEN (session_start || ' 13:00:00')::timestamp
        WHEN court_session = 'PM' THEN (session_start || ' 18:00:00')::timestamp
        WHEN court_session = 'AD' THEN (session_start || ' 23:59:00')::timestamp
        ELSE NULL
    END"/>
