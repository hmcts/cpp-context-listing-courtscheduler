<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.3.xsd">

    <changeSet id="046" author="koray.kaya" logicalFilePath="046-rota-process-log.xml">
        <createTable tableName="rota_process_log">
            <column name="id" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="execution_id" type="VARCHAR(100)"/>
            <column name="timestamp" type="timestamp with timezone">
                <constraints nullable="false"/>
            </column>
            <column name="error_code" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="error_text" type="text">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
